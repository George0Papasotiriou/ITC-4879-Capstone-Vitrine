{
  "name": "vitrine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-native e-shop. ITC 4949 Capstone Project.",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "local": "node scripts/local.mjs dev",
    "local:start": "node scripts/local.mjs start",
    "local:db": "node scripts/local.mjs db",
    "catalog": "node scripts/local.mjs catalog",
    "reco": "node scripts/local.mjs run scripts/reco.ts",
    "evals:stylist": "node scripts/local.mjs run scripts/evaluate-stylist.ts",
    "evals:room": "tsx scripts/evaluate-room-geometry.ts",
    "geoip": "tsx scripts/geoip.ts",
    "worker:dev": "tsx watch src/worker/index.ts",
    "build": "next build && pnpm build:worker",
    "build:worker": "tsup",
    "start": "next start",
    "worker:start": "node dist/worker/index.js",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:setup": "pnpm db:migrate && tsx scripts/catalog.ts seed --if-empty && tsx scripts/reco.ts simulate --if-empty && tsx scripts/reco.ts rebuild --if-empty",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1130.0",
    "@aws-sdk/s3-request-presigner": "3.1130.0",
    "@sentry/nextjs": "10.74.0",
    "bullmq": "6.3.4",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "ioredis": "6.0.0",
    "motion": "13.2.0",
    "next": "16.3.5",
    "next-intl": "4.14.4",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "uuidv7": "1.2.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@electric-sql/pglite-socket": "0.2.11",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "lighthouse": "13.4.1",
    "pino-pretty": "13.1.3",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
