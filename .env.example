# Vitrine environment variables — names only (docs/PLAN.md Appendix A).
#
# Locally you do not need this file: `pnpm local` starts the database and passes
# every variable the app needs. These names are for a deployed environment,
# where the host provides the values. Never commit a filled-in copy.
#
# Jobs and storage each have two drivers (ADR-008). A driver is inferred from the
# credentials present, and only its own variables are required. The local
# stand-ins (inline jobs, local storage) are refused in production.

# --- Core -------------------------------------------------------------------
APP_URL=
DATABASE_URL=

# --- Jobs: bullmq (production) | inline (local stand-in) --------------------
JOBS_DRIVER=
REDIS_URL=

# --- Storage: s3 (production) | local (local stand-in) ----------------------
STORAGE_DRIVER=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Local driver only. `pnpm local` generates this for you.
LOCAL_STORAGE_DIR=
LOCAL_STORAGE_SECRET=
# Signs guest cart cookies and order links; at least 32 characters. `pnpm local` generates this.
COOKIE_SECRET=
# Prices by country. Path to the IP-to-country database (`pnpm geoip update` writes a fast .bin
# next to the CSV; either works), and/or a trusted
# CDN header carrying the country (e.g. cf-ipcountry). Both optional.
GEOIP_DATABASE=
GEO_COUNTRY_HEADER=
# Set only by the local stack; permits the stand-ins under NODE_ENV=production.
VITRINE_LOCAL=

# --- Observability -----------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=info

# --- Phase 1 only -----------------------------------------------------------
# Shared secret for /api/dev/ping (>=16 chars). Leave unset to disable the route.
DEV_PING_TOKEN=
# Accounts (docs/adr/016). Signs sessions; required in production, at least 32 characters.
BETTER_AUTH_SECRET=
# Optional: "Continue with Google". Both or neither.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: send emails through Resend as well as keeping them in the outbox.
RESEND_API_KEY=
EMAIL_FROM=
# Optional: addresses that become admins once signed in with the address confirmed (comma-separated).
ADMIN_EMAILS=

# AI (docs/adr/019). AI_PROVIDER: google | demo | off (unset: google with a key, demo locally, off otherwise)
AI_PROVIDER=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
VOICE_PROVIDER=google
FASHN_API_KEY=
AI_DAILY_BUDGET_EUR=3
AI_KILL_SWITCH=0

# Showcase accounts (docs/adr/028): when set, every deploy makes sure eight accounts exist, two per
# role (customer1@vitrine.test ... admin2@vitrine.test), all with this password, and writes their
# history once. At least 12 characters. Leave it unset in a real shop. `pnpm exec tsx scripts/showcase.ts lock`
# closes them again. Set it in Railway yourself; never commit a value.
SHOWCASE_PASSWORD=
